# Local development only. Copy this file to infra/.env and change the password.
POSTGRES_DB=thuyetminh
POSTGRES_USER=thuyetminh
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_PORT=5432
BACKEND_PORT=8080

SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
APP_AUTH_SESSION_TTL=8h

# First-admin bootstrap is disabled by default. Enable only for initial local setup.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=

# "none" uses uploaded audio; "google" requires separately configured credentials.
APP_TTS_PROVIDER=none
APP_TTS_MAX_INPUT_BYTES=4500
APP_TTS_REQUEST_TIMEOUT=30s
APP_TTS_MAX_ATTEMPTS=3
