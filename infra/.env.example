# Copy to infra/.env (git-ignored). Local development only.
POSTGRES_DB=thuyetminh
POSTGRES_USER=thuyetminh
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=dev
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# One-time creation of the first admin. Choose your own password (>= 12 chars). No default exists.
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=

# TTS: "none" (default, upload audio manually) or "google"
APP_TTS_PROVIDER=none
# When google: absolute host path of the service-account JSON + container path
GOOGLE_CREDENTIALS_FILE_ON_HOST=
GOOGLE_APPLICATION_CREDENTIALS_IN_CONTAINER=/run/secrets/gcp-tts.json
