# Copy to .env (git-ignored). Values are compiled into the app and are NOT secret.
# Backend URL. Leave empty to use the defaults:
#   Android emulator -> http://10.0.2.2:8080 ; iOS simulator -> http://localhost:8080
# Physical phone: use the LAN IP of the machine running the backend, e.g. http://192.168.1.20:8080
API_BASE_URL=
# Google Maps SDK keys. Restrict them in Google Cloud Console (see docs/google-maps.md).
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=
