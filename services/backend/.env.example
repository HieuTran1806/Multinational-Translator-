# Environment variables read by the backend (export them or use your IDE run config).
# Running with ./mvnw spring-boot:run — see services/backend/README.md
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:postgresql://localhost:5432/thuyetminh
DB_USERNAME=thuyetminh
DB_PASSWORD=change-me-local-db-password
PORT=8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_AUTH_SESSION_TTL=8h
APP_STORAGE_LOCAL_ROOT=./data/media
APP_BOOTSTRAP_ADMIN_ENABLED=false
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_TTS_PROVIDER=none
APP_TTS_MAX_INPUT_BYTES=4500
APP_TTS_REQUEST_TIMEOUT=30s
APP_TTS_MAX_ATTEMPTS=3
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/outside/repo/gcp-tts.json
# Integration tests
TEST_DB_URL=jdbc:postgresql://localhost:5432/thuyetminh_test
TEST_DB_USERNAME=thuyetminh
TEST_DB_PASSWORD=change-me-local-db-password
